# =============================================================
#  Agente_YT - Configuracion de entorno
#  Copia este archivo a ".env" y rellena SOLO lo que uses.
# =============================================================

# Proveedor LLM a usar en los nodos 2 y 3:
#   mock      -> NO gasta dinero, NO requiere clave (para probar el pipeline)
#   anthropic -> Claude (requiere ANTHROPIC_API_KEY, paquete "anthropic")
#   openai    -> GPT   (requiere OPENAI_API_KEY, paquete "openai")
#   nvidia    -> Modelos abiertos alojados por NVIDIA, API compatible con OpenAI
#                (requiere NVIDIA_API_KEY y el paquete "openai"). Ideal para
#                estirar/abaratar tokens sin perder calidad.
#   multi     -> Reparte las llamadas entre varios proveedores (rotacion) con
#                fallback automatico. Define la lista en AGENTE_YT_LLM_PROVIDERS.
AGENTE_YT_LLM_PROVIDER=mock

# Solo para provider=multi: proveedores a repartir (en orden). Se usan solo los
# que tengan credenciales; si uno falla o tarda, se pasa al siguiente.
AGENTE_YT_LLM_PROVIDERS=nvidia,anthropic,openai
# Timeout (segundos) por llamada al LLM. Evita que una respuesta lenta cuelgue
# el proceso; en modo 'multi' dispara el salto al siguiente proveedor.
AGENTE_YT_LLM_TIMEOUT=60

# Modelo a usar. Dejalo VACIO para usar el modelo por defecto del proveedor:
#   anthropic: claude-3-5-sonnet-latest
#   openai:    gpt-4o
#   nvidia:    meta/llama-3.3-70b-instruct
#              (otros: nvidia/llama-3.1-nemotron-70b-instruct,
#               deepseek-ai/deepseek-r1, qwen/qwen2.5-72b-instruct, ...)
AGENTE_YT_LLM_MODEL=

# --- Claves de API (rellena solo la del proveedor elegido) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Clave de NVIDIA (formato nvapi-...), desde https://build.nvidia.com
NVIDIA_API_KEY=
# (Opcional) base URL de la API de NVIDIA compatible con OpenAI
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Nodo 5: Higgsfield (API REST oficial: platform.higgsfield.ai) ---
# Consigue tus claves KEY:SECRET en https://cloud.higgsfield.ai/api-keys
# OJO: generar consume CREDITOS DE PAGO (imagen 1080p ~3 cred; video ~6.5 cred).
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=

# (Opcional) Base URL de la API; por defecto la oficial.
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Calidad de imagen: 720p | 1080p
HIGGSFIELD_QUALITY=1080p
# Tamano de imagen (ej: 2048x1152 = 16:9 apaisado para YouTube)
HIGGSFIELD_IMAGE_SIZE=2048x1152

# --- Animar la imagen a video (opcional) ---
# Si defines un MOTION_ID, cada imagen generada se anima a un clip de video.
# Consulta los motions disponibles con: python -m agente_yt --listar-motions
HIGGSFIELD_MOTION_ID=
# Modelo de video: dop-lite | dop-turbo | dop-preview
HIGGSFIELD_VIDEO_MODEL=dop-turbo

# Carpeta donde se guardan los resultados (guion.json, prompts.json)
AGENTE_YT_OUTPUT_DIR=salidas

# --- Nodo 7: Montaje final (ffmpeg) ---
# Ruta al binario ffmpeg. Si se deja vacio, se busca en el PATH y, como ultimo
# recurso, el que trae el paquete opcional "imageio-ffmpeg".
AGENTE_YT_FFMPEG=
# Resolucion y fps del video final (1920x1080 = 1080p 16:9 para YouTube)
AGENTE_YT_VIDEO_SIZE=1920x1080
AGENTE_YT_VIDEO_FPS=30
# Duracion por defecto (segundos) de cada imagen fija en el montaje
AGENTE_YT_IMG_DURATION=5

# --- Nodo 8: Voz / Narracion (TTS) ---
# Proveedor de texto-a-voz:
#   mock   -> offline, sin red ni clave (genera un audio de placeholder)
#   edge   -> Microsoft Edge TTS (GRATIS, sin clave; requiere internet y "edge-tts")
#   gtts   -> Google Translate TTS (GRATIS, sin clave; requiere internet y "gTTS")
#   openai -> OpenAI TTS (requiere OPENAI_API_KEY y el paquete "openai")
AGENTE_YT_TTS_PROVIDER=mock
# Voz concreta (opcional; si se deja vacio se elige una por defecto segun idioma).
#   edge:   es-ES-AlvaroNeural, es-MX-DaliaNeural, en-US-AriaNeural, ...
#   openai: alloy, echo, fable, onyx, nova, shimmer
AGENTE_YT_TTS_VOICE=
# Modelo (solo openai): tts-1 | tts-1-hd
AGENTE_YT_TTS_MODEL=tts-1

# --- Musica de fondo y subtitulos (montaje) ---
# Ruta a una pista de musica de fondo por defecto (opcional).
AGENTE_YT_MUSICA=
# Volumen de la musica de fondo respecto a la voz (0.0 - 1.0). Bajo por defecto.
AGENTE_YT_VOLUMEN_MUSICA=0.18

# --- Nodo 11: Subida a YouTube (Data API v3, OAuth2) ---
# La subida requiere OAuth (no basta una API key). Crea credenciales OAuth de
# tipo "App de escritorio" en Google Cloud (con YouTube Data API v3 habilitada)
# y descarga el client_secrets.json.
AGENTE_YT_YT_CLIENT_SECRETS=
# Donde se guarda/lee el token OAuth (se crea la primera vez con tu consentimiento).
AGENTE_YT_YT_TOKEN=youtube_token.json
# Privacidad del video subido: private | unlisted | public
AGENTE_YT_YT_PRIVACY=unlisted
# Categoria de YouTube (22=Gente y blogs, 10=Musica, 1=Cine y animacion)
AGENTE_YT_YT_CATEGORY=22

# --- Nodo 13: Intro / outro animados ---
# Texto de la tarjeta de cierre (llamada a la accion).
AGENTE_YT_OUTRO_TEXTO=Gracias por ver. Suscribete!
# Duracion (segundos) de la portada (intro) y del cierre (outro).
AGENTE_YT_INTRO_DUR=3
AGENTE_YT_OUTRO_DUR=3
