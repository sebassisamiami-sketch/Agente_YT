# =============================================================
#  Agente_YT - Configuracion de entorno
#  Copia este archivo a ".env" y rellena SOLO lo que uses.
# =============================================================

# Proveedor LLM a usar en los nodos 2 y 3:
#   mock      -> NO gasta dinero, NO requiere clave (para probar el pipeline)
#   anthropic -> Claude (requiere ANTHROPIC_API_KEY, paquete "anthropic")
#   openai    -> GPT   (requiere OPENAI_API_KEY, paquete "openai")
AGENTE_YT_LLM_PROVIDER=mock

# Modelo a usar (segun el proveedor)
#   anthropic: claude-3-5-sonnet-latest
#   openai:    gpt-4o
AGENTE_YT_LLM_MODEL=claude-3-5-sonnet-latest

# --- Claves de API (rellena solo la del proveedor elegido) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Nodo 5: Higgsfield (API REST oficial: platform.higgsfield.ai) ---
# Consigue tus claves KEY:SECRET en https://cloud.higgsfield.ai/api-keys
# OJO: generar consume CREDITOS DE PAGO (imagen 1080p ~3 cred; video ~6.5 cred).
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=

# (Opcional) Base URL de la API; por defecto la oficial.
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Calidad de imagen: 720p | 1080p
HIGGSFIELD_QUALITY=1080p
# Tamano de imagen (ej: 2048x1152 = 16:9 apaisado para YouTube)
HIGGSFIELD_IMAGE_SIZE=2048x1152

# --- Animar la imagen a video (opcional) ---
# Si defines un MOTION_ID, cada imagen generada se anima a un clip de video.
# Consulta los motions disponibles con: python -m agente_yt --listar-motions
HIGGSFIELD_MOTION_ID=
# Modelo de video: dop-lite | dop-turbo | dop-preview
HIGGSFIELD_VIDEO_MODEL=dop-turbo

# Carpeta donde se guardan los resultados (guion.json, prompts.json)
AGENTE_YT_OUTPUT_DIR=salidas
